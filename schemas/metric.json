{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricDefinition",
  "type": "object",
  "properties": {
    "metric_id": { "type": "string" },
    "name": { "type": "string" },
    "level": {
      "type": "string",
      "enum": ["North Star", "Business KPI", "Experiment KPI", "Diagnostic Metric"]
    },
    "calculation_method": { "type": "string" },
    "unit": { "type": "string" }
  },
  "required": ["metric_id", "name", "level", "calculation_method"]
}
